    {
      "name": "time",
      "min_params": 1,
      "max_params": 2,
      "widget_max_params": 1,
      "format_param": -1,
      "validation_mode": 0,
      "free_form": true,
      "category": "Time",
      "summary": "Wall clock and date via strftime, plus sub-second codes.",
      "note": "Shows --:-- until the clock has synced over NTP. The format cannot contain ';'.",
      "params": [
        {
          "name": "format",
          "desc": "strftime format plus %ms, %cs, %ds, or %ums for uptime.",
          "required": true
        },
        {
          "name": "timezone",
          "desc": "Olson name such as Europe/Amsterdam, or a POSIX TZ string.",
          "required": false
        }
      ],
      "examples": [
        {
          "code": "[time:%H:%M;Europe/Amsterdam]",
          "desc": "Local time with daylight saving."
        },
        {
          "code": "[time:%a %d %b]",
          "desc": "Short date in the device timezone."
        },
        {
          "code": "[time:%ums]",
          "desc": "Uptime in ms; works before NTP sync."
        }
      ],
      "reference": {
        "title": "Clock & date",
        "formats": true,
        "rows": [
          {
            "syntax": "%H:%M",
            "sample": "14:05",
            "desc": "24-hour clock",
            "example": "[time:%H:%M]"
          },
          {
            "syntax": "%I:%M %p",
            "sample": "02:05 PM",
            "desc": "12-hour clock",
            "example": "[time:%I:%M %p]"
          },
          {
            "syntax": "%H:%M:%S",
            "sample": "14:05:09",
            "desc": "With seconds",
            "example": "[time:%H:%M:%S]"
          },
          {
            "syntax": "%H:%M:%S.%ms",
            "sample": "14:05:09.347",
            "desc": "Milliseconds; %cs and %ds give 1/100 and 1/10",
            "example": "[time:%H:%M:%S.%ms]"
          },
          {
            "syntax": "%a %d %b",
            "sample": "Fri 09 Oct",
            "desc": "Short date",
            "example": "[time:%a %d %b]"
          },
          {
            "syntax": "%A",
            "sample": "Friday",
            "desc": "Weekday name",
            "example": "[time:%A]"
          },
          {
            "syntax": "%d-%m-%Y",
            "sample": "09-10-2026",
            "desc": "Day-month-year",
            "example": "[time:%d-%m-%Y]"
          },
          {
            "syntax": "%Y-%m-%d",
            "sample": "2026-10-09",
            "desc": "ISO date",
            "example": "[time:%Y-%m-%d]"
          },
          {
            "syntax": "%V",
            "sample": "41",
            "desc": "ISO week number",
            "example": "[time:Week %V]"
          },
          {
            "syntax": "%ums",
            "sample": "734512",
            "desc": "Uptime in ms, before NTP sync too",
            "example": "[time:%ums]"
          }
        ]
      }
    },
    {
      "name": "expr",
      "min_params": 1,
      "max_params": 2,
      "widget_max_params": 1,
      "format_param": 1,
      "validation_mode": 1,
      "free_form": true,
      "category": "Logic",
      "summary": "Calculate values, compare them, and choose text or colors.",
      "note": "Quote strings with double quotes. There are no && or || operators; nest ternaries instead.",
      "params": [
        {
          "name": "expression",
          "desc": "Arithmetic, comparisons, ternaries, and threshold(); inner tokens resolve first.",
          "required": true
        },
        {
          "name": "format",
          "desc": "printf format applied to the result, e.g. %.1f.",
          "required": false
        }
      ],
      "examples": [
        {
          "code": "[expr:[health:cpu] > 80 ? \"High\" : \"OK\"]",
          "desc": "Text chosen by a condition."
        },
        {
          "code": "[expr:([health:heap_free] / 1024);%.0f KB]",
          "desc": "Derived number with a unit."
        },
        {
          "code": "[expr:threshold([health:cpu],\"#16a34a\",50,\"#f59e0b\",80,\"#dc2626\")]",
          "desc": "Map a number to color zones."
        },
        {
          "code": "[expr:[time:%ms] % 500 < 250 ? \"#dc2626\" : \"#f8fafc\"]",
          "desc": "Blink between two colors."
        }
      ],
      "reference": {
        "title": "Operators & functions",
        "formats": false,
        "rows": [
          {
            "group": "Arithmetic",
            "syntax": "a + b",
            "desc": "Add; also - * /",
            "example": "[expr:[health:heap_free] / 1024;%.0f]"
          },
          {
            "group": "Arithmetic",
            "syntax": "a % b",
            "desc": "Remainder, useful for blinking",
            "example": "[expr:[time:%ms] % 500 < 250]"
          },
          {
            "group": "Arithmetic",
            "syntax": "-a",
            "desc": "Negate",
            "example": "[expr:-[health:rssi]]"
          },
          {
            "group": "Arithmetic",
            "syntax": "( a )",
            "desc": "Grouping",
            "example": "[expr:([health:cpu] + 5) * 2]"
          },
          {
            "group": "Comparison",
            "syntax": "a > b",
            "desc": "Also < >= <=; result is 1 or 0",
            "example": "[expr:[health:cpu] > 80]"
          },
          {
            "group": "Comparison",
            "syntax": "a == b",
            "desc": "Equal on numbers or \"strings\"; also !=",
            "example": "[expr:[health:wifi_connected]==\"ON\"]"
          },
          {
            "group": "Conditional",
            "syntax": "c ? x : y",
            "desc": "Ternary; branches can be numbers or \"strings\" and can be chained",
            "example": "[expr:[health:cpu] > 80 ? \"High\" : \"OK\"]"
          },
          {
            "group": "Functions",
            "syntax": "threshold(v, c0, t1, c1, ...)",
            "desc": "c0 below t1, c1 below t2, ..., else the last value; thresholds ascend",
            "example": "[expr:threshold([health:cpu],\"#16a34a\",50,\"#dc2626\")]"
          }
        ]
      }
    },
    {
      "name": "mqtt",
      "min_params": 1,
      "max_params": 3,
      "widget_max_params": 2,
      "format_param": 2,
      "validation_mode": 0,
      "free_form": true,
      "category": "Data",
      "summary": "Live values from MQTT topics, optionally from a JSON field.",
      "note": "Topics are subscribed when the pad is saved. Values show --- until the first message.",
      "status": "No MQTT broker configured",
      "params": [
        {
          "name": "topic",
          "desc": "MQTT topic to subscribe to.",
          "required": true
        },
        {
          "name": "path",
          "desc": "JSON field such as temperature or a.b; empty or . for the raw payload.",
          "required": false
        },
        {
          "name": "format",
          "desc": "printf format: %d, %.1f, %s, with units inside, e.g. %.1f °C.",
          "required": false
        }
      ],
      "examples": [
        {
          "code": "[mqtt:sensors/temp]",
          "desc": "Raw payload of a topic."
        },
        {
          "code": "[mqtt:sensors/state;temperature;%.1f °C]",
          "desc": "JSON field formatted with a unit."
        },
        {
          "code": "[mqtt:solar/power;watts|0]",
          "desc": "Show 0 until the first message arrives."
        },
        {
          "code": "Power: [mqtt:grid;power;%d] W",
          "desc": "Text around a token is kept."
        }
      ]
    },
    {
      "name": "pad",
      "min_params": 1,
      "max_params": 2,
      "widget_max_params": 1,
      "format_param": 1,
      "validation_mode": 0,
      "free_form": true,
      "category": "Logic",
      "summary": "Reuse a binding defined once in the pad's Bindings list.",
      "note": "Pads only. Use it to shorten long tokens in fields with a smaller length limit.",
      "params": [
        {
          "name": "name",
          "desc": "Name from the pad's Bindings list.",
          "required": true
        },
        {
          "name": "format",
          "desc": "printf float format such as %.1f, or %s for text.",
          "required": false
        }
      ],
      "examples": [
        {
          "code": "[pad:power]",
          "desc": "Raw value of the named pad binding."
        },
        {
          "code": "[pad:power;%.0f W]",
          "desc": "Local format without redefining the source."
        },
        {
          "code": "[expr:[pad:power] > 3000 ? \"High\" : \"Low\"]",
          "desc": "Reuse a named value inside an expression."
        }
      ]
    },
    {
      "name": "timer",
      "min_params": 1,
      "max_params": 2,
      "widget_max_params": 1,
      "format_param": 1,
      "validation_mode": 0,
      "free_form": false,
      "keys": [
        "1",
        "1_state",
        "1_mode",
        "1_expired",
        "1_target",
        "2",
        "2_state",
        "2_mode",
        "2_expired",
        "2_target",
        "3",
        "3_state",
        "3_mode",
        "3_expired",
        "3_target"
      ],
      "category": "Device",
      "summary": "Value and state of the 3 on-device timers.",
      "note": "Countdowns that run past zero show negative values, e.g. -0:05.",
      "params": [
        {
          "name": "key",
          "desc": "Timer number 1-3, or N_state, N_mode, N_expired, N_target.",
          "required": true
        },
        {
          "name": "format",
          "desc": "Duration format for the timer value, see Format strings.",
          "required": false
        }
      ],
      "key_docs": [
        {
          "key": "#",
          "desc": "Timer value; default 245.3 (seconds with tenths)"
        },
        {
          "key": "#_state",
          "desc": "running, paused, or stopped"
        },
        {
          "key": "#_mode",
          "desc": "up (count-up) or down (countdown)"
        },
        {
          "key": "#_expired",
          "desc": "ON once a countdown has passed zero"
        },
        {
          "key": "#_target",
          "desc": "Countdown preset in whole seconds; 0 for count-up"
        }
      ],
      "examples": [
        {
          "code": "[timer:1;mm:ss]",
          "desc": "Timer 1 as minutes and seconds."
        },
        {
          "code": "[timer:1_target]",
          "desc": "Stable maximum for a countdown gauge."
        },
        {
          "code": "[expr:[timer:1_expired]==\"ON\"?\"#dc2626\":\"#333333\"]",
          "desc": "Red once the countdown expires."
        }
      ],
      "reference": {
        "title": "Timer durations",
        "formats": true,
        "rows": [
          {
            "syntax": "mm:ss",
            "sample": "4:05",
            "desc": "Minutes and seconds",
            "example": "[timer:1;mm:ss]"
          },
          {
            "syntax": "hh:mm:ss",
            "sample": "0:04:05",
            "desc": "With hours",
            "example": "[timer:1;hh:mm:ss]"
          },
          {
            "syntax": "mm:ss.d",
            "sample": "4:05.3",
            "desc": "With tenths",
            "example": "[timer:1;mm:ss.d]"
          },
          {
            "syntax": "ss",
            "sample": "245",
            "desc": "Whole seconds",
            "example": "[timer:1;ss]"
          }
        ]
      }
    },
