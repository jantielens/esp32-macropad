#pragma once

// Copy this file to stt_credentials.h (which is ignored by Git), then replace
// the API-key placeholder. Firmware submits audio to the Azure AI Foundry
// deployment-specific transcription endpoint.
#define STT_AZURE_HOST "foundry-openclaw-tlns.services.ai.azure.com"
#define STT_AZURE_API_KEY "REPLACE_WITH_YOUR_AZURE_FOUNDRY_API_KEY"
// Use the deployment name shown in Azure AI Foundry, which can differ from
// the catalog model name (for example, gpt-4o-transcribe).
#define STT_AZURE_MODEL "gpt-4o-transcribe"