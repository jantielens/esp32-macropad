# Bundle manifest for portal.js
#
# JS modules are concatenated (in order) into NAMED chunks. Each chunk is
# independently minified + gzipped and emitted as its own PROGMEM array.
#
# Chunk markers:
#   # [chunk:NAME]            — always-on chunk
#   # [chunk:NAME HAS_FLAG]   — compiled out of flash unless HAS_FLAG is true
#
# The first marker opens the first chunk; each subsequent marker closes the
# previous one. Files before any marker are rejected. Disabled chunks are
# compiled out via #if guards in web_assets.h, so they never reach flash.
#
# Build-time assembly: the minifier enumerates the unique HAS_* flag set
# across chunks (capped at 3 -> 8 variants), and for each 2^N combination
# concatenates the chunks whose flag is unset OR matches the combination,
# then gzips ONCE. Each variant is emitted as an #if-guarded PROGMEM blob
# under the same symbol name (portal_js_gz), so exactly one variant links.
#
# Runtime loading: shell.html issues a single GET /portal.js, which returns
# the one matching combined-gzip blob in a single HTTP response.

# [chunk:core]
# Core infrastructure
portal_core.js

# Custom dropdown (replaces native <select> popup; auto-enhances on load)
portal_dropdown.js

# Shared libraries (used by config and pad editor)
portal_binding_validator.js

# [chunk:actions HAS_DISPLAY]
# Action editor + config actions UI: only reachable from pad/swipe/boot/timer
# editors, all of which are HAS_DISPLAY-gated fragments.
portal_action_editor.js
portal_config_actions.js

# Home Assistant Service action-editor extension. Registers the "ha_service"
# type with the shared editor via the _actionEditorExtensions hook array, so
# it must come after portal_action_editor.js (which defines the hook). Core
# feature (not device-class), so it lives under src/app/web/.
portal_action_editor_ha.js

# [chunk:shutter_actions IS_SHUTTER_TESTER]
# Shutter Tester action-editor extension. Registers the "shutter" action type
# with the shared editor via the _actionEditorExtensions hook array, so only
# shutter-tester builds pay the flash cost. Must come after the actions chunk
# (which defines _actionEditorExtensions). Lives under
# src/app/device_classes/shutter_tester/web/ — the asset bundler scans
# device_classes/*/web/ for *.js files.
portal_action_editor_shutter.js

# [chunk:shutter_pages IS_SHUTTER_TESTER]
# Shutter Tester portal pages: Sensor Configuration, Session Save Actions,
# sessions list/detail, and guided test editor. Each module installs its own
# init_<id>_fragment() handler that portal_fragment_init.js (in the shell
# chunk) invokes when that fragment loads. portal_shutter_config.js must come
# first because it calls registerConfigFields() to extend the shared config
# save loop with shutter-specific NVS keys. Lives under
# src/app/device_classes/shutter_tester/web/.
portal_shutter_config.js
portal_shutter_sessions.js
portal_shutter_tests.js

# [chunk:config]
# Configuration (main config page — non-display settings stay always-on)
portal_config.js

# Firmware page
portal_firmware.js

# Health monitoring (sparkline fragment before main health)
portal_health_sparkline.js
portal_health.js
portal_storage.js

# [chunk:music HAS_SOUND_PLAYER]
portal_music.js

# [chunk:pad HAS_DISPLAY]
# Pad editor — only consumed by the pad editor fragment on display boards.
portal_pad_colors.js
portal_pad_io.js
portal_pad_blocks.js
portal_pad_icons.js
portal_pad_defaults.js
portal_pad_grid.js
portal_pad_dialog.js
portal_pad_editor.js

# [chunk:shell]
# Navigation shell, fragment init, and the entry point (must be last chunk).
portal_nav.js
portal_fragment_init.js
portal.js

# [chunk:epaper HAS_EPAPER]
# E-paper portal fragment init handlers. Lives under
# src/app/device_classes/epaper/web/ — the asset bundler also scans
# device_classes/*/web/ for *.js files and *.fragment.html. Functions are
# only invoked when an e-paper fragment is loaded, so ordering relative to
# the shell chunk is immaterial.
epaper_init.js

# [chunk:coffee_scale_actions IS_COFFEE_SCALE]
# Coffee Scale action-editor extensions. Registers "scale" + "brew" types
# with the shared editor via the _actionEditorExtensions hook array. Must come
# after the actions chunk (which defines _actionEditorExtensions).
portal_action_editor_scale.js

# [chunk:coffee_scale_pages IS_COFFEE_SCALE]
# Coffee Scale portal pages: scale calibration, brew session list/detail, and
# brew template editor. Each module installs its own init_<id>_fragment()
# handler that portal_fragment_init.js invokes when its fragment loads.
# portal_brews_init.js must come first because it calls registerConfigFields()
# to extend the shared config save loop with the scale_smooth NVS key.
portal_brews_init.js
portal_brews.js
portal_brews_charts.js
portal_brews_templates.js

# [chunk:darkroom_actions IS_DARKROOM_TIMER]
# Darkroom Timer action-editor extension. Registers the expose/strip/meter/
# print/shelly types with the shared editor via the _actionEditorExtensions
# hook array. Must come after the actions chunk (which defines the hook).
portal_action_editor_darkroom.js

# [chunk:darkroom_pages IS_DARKROOM_TIMER]
# Darkroom Timer portal pages: relay-config init + print session log viewer.
# portal_darkroom_init.js owns the relay-slot editor helpers and the
# init_<id>_fragment() handlers that portal_fragment_init.js invokes on load.
portal_darkroom_init.js
portal_prints.js
