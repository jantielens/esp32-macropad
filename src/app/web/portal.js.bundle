# Bundle manifest for portal.js
#
# JS modules are concatenated (in order) into a portal.js asset served as a
# single HTTP endpoint. Fragment files are excluded from individual serving.
#
# Order: core → libraries → features → nav → fragment init → entry point
# The last entry MUST be the primary file (portal.js).
#
# `# [HAS_FLAG]` / `# [/HAS_FLAG]` markers split the bundle into chunks. Each
# chunk is independently gzipped and emitted as its own PROGMEM array guarded
# by `#if HAS_FLAG`. At serve time the runtime streams the enabled chunks
# back-to-back (multi-member gzip — RFC 1952 — handled natively by browsers).
# Boards with HAS_DISPLAY=false drop the pad-editor / action-editor JS this way.

# Core infrastructure
portal_core.js

# Custom dropdown (replaces native <select> popup; auto-enhances on load)
portal_dropdown.js

# Shared libraries (used by config and pad editor)
portal_binding_validator.js

# [HAS_DISPLAY]
# Action editor + config actions UI: only reachable from pad/swipe/boot/timer
# editors, all of which are HAS_DISPLAY-gated fragments.
portal_action_editor.js
portal_config_actions.js
# [/HAS_DISPLAY]

# Configuration (main config page — non-display settings stay always-on)
portal_config.js

# Firmware page
portal_firmware.js

# Health monitoring (sparkline fragment before main health)
portal_health_sparkline.js
portal_health.js

# [HAS_DISPLAY]
# Pad editor — only consumed by the pad editor fragment on display boards.
portal_pad_colors.js
portal_pad_io.js
portal_pad_blocks.js
portal_pad_icons.js
portal_pad_defaults.js
portal_pad_grid.js
portal_pad_dialog.js
portal_pad_editor.js
# [/HAS_DISPLAY]

# Navigation shell and fragment initialization
portal_nav.js
portal_fragment_init.js

# Entry point (must be last)
portal.js
