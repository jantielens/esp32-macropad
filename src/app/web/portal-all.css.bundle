# CSS bundle manifest for portal-all.css
# Combines vendor framework + portal styles into a single asset to reduce
# parallel HTTP requests at portal load (mitigates ESP-Hosted SDIO DMA pressure).
# Order follows CSS cascade: framework first, custom overrides last.
#
# Chunk markers use the same compiler-resolved predicates as JavaScript.
# Only matching groups are concatenated into this build's single CSS asset.
# [chunk:core]
bootstrap.min.css
portal-custom.css
portal-all.css

# [chunk:pad HAS_DISPLAY]
portal_binding_help.css
portal_binding_builder.css
portal_button_builder.css
portal_dialog_appearance.css
@widgets

# [chunk:shutter IS_SHUTTER_TESTER]
portal_shutter.css

# [chunk:coffee_scale IS_COFFEE_SCALE]
portal_brews.css

# [chunk:darkroom_timer IS_DARKROOM_TIMER]
portal_darkroom.css
